<?xml version="1.0" encoding="utf-8"?>
<!-- SARASWATI: exclude every domain, in both cloud-backup and
     device-transfer (audit NEW-3). targetSdk 36 allowBackup=false (Task 4,
     gms flavor) stops cloud backup, but NOT phone-to-phone device transfer
     (Android's "Copy your data" flow over Wi-Fi Direct/cable), which would
     otherwise copy the sign-in WebView's cookie jar under app_webview/
     (domain="file") to the new phone. The device_* domains below are
     transfer-only overrides so this holds even if a future change narrows
     the plain domains for cloud-backup alone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="root"
            path="." />
        <exclude
            domain="file"
            path="." />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="sharedpref"
            path="." />
        <exclude
            domain="external"
            path="." />
        <exclude
            domain="device_root"
            path="." />
        <exclude
            domain="device_file"
            path="." />
        <exclude
            domain="device_database"
            path="." />
        <exclude
            domain="device_sharedpref"
            path="." />
    </device-transfer>
</data-extraction-rules>
