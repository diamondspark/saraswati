<?xml version="1.0" encoding="utf-8"?>
<!-- SARASWATI: exclude every backup domain entirely (audit NEW-3), not just
     the ExoPlayer cache upstream excluded. allowBackup=false (Task 4, gms
     flavor) already stops this full-backup mechanism on targetSdk 36; this
     file is the second layer if that flag is ever flipped back on. -->
<full-backup-content>
    <exclude
        domain="root"
        path="." />
    <exclude
        domain="file"
        path="." />
    <exclude
        domain="database"
        path="." />
    <exclude
        domain="sharedpref"
        path="." />
    <exclude
        domain="external"
        path="." />
</full-backup-content>
