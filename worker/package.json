{
  "name": "saraswati-sangat",
  "version": "0.1.0",
  "private": true,
  "description": "Cloudflare Worker backing the Saraswati family hub (FamilyHub Durable Object).",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:traces": "vitest run --config vitest.traces.config.ts",
    "traces:record": "node --experimental-strip-types scripts/record-traces.ts",
    "gen": "buf generate ../app/src/main/proto --template buf.gen.yaml",
    "gen:check": "d=$(mktemp -d) && trap 'rm -rf \"$d\"' EXIT && buf generate ../app/src/main/proto --template buf.gen.yaml --output \"$d\" && diff -r \"$d/src/gen\" src/gen",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.74.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@cloudflare/workers-types": "5.20261018.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  }
}
